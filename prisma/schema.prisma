// ============================================================
//  SuperDonat — схема базы данных (Prisma + PostgreSQL)
//  Сайт пополнения игровой валюты. Комментарии на русском — чтобы
//  заказчик мог ориентироваться в структуре.
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PaymentStatus {
  pending // ждёт проверки админом
  approved // одобрено
  rejected // отклонено
}

enum Role {
  student
  admin
}

// Тип товара внутри игры.
enum PackageKind {
  currency // игровая валюта (алмазы, UC и т.п.)
  pass // сезонный/недельный пропуск
  voucher // ваучер/купон/подписка
  bundle // разовый набор/кейс (напр. Weekly Deal Pack)
}

enum OrderStatus {
  pending // ждёт ручной выдачи валюты в игре
  completed // выдано
  rejected // отклонено (неверный ID и т.п.)
  failed // авто-заказ через внешний API (FazerCards) не прошёл — баланс уже
  // возвращён автоматически, заказ ждёт ручного разбора отдельно от
  // обычной очереди pending
}

// Причина движения баланса — журнал, а не просто число на User.
enum BalanceTxReason {
  topup // пополнение через TopUp
  order // списание за покупку в игре
  referral // реферальный бонус (% с покупки приглашённого)
  admin // ручная корректировка админом
  promo // бонус по промокоду
  refund // автоматический возврат (напр. сбой авто-заказа у внешнего API)
}

model User {
  id           String    @id @default(uuid())
  name         String
  // Хотя бы один из email/phone обязателен на уровне логики,
  // но при регистрации по ТЗ спрашиваем оба. Оба уникальны.
  email        String?   @unique
  phone        String?   @unique
  passwordHash String    @map("password_hash")
  role         Role      @default(student)
  balance      Decimal   @default(0) @db.Decimal(10, 2)
  avatarUrl    String?   @map("avatar_url")
  // Реферальная программа: свой код (генерируется при регистрации, см.
  // actions/auth.ts) для ссылки-приглашения, и кто пригласил этого
  // пользователя — необязательно, только если пришёл по чужой ссылке.
  referralCode String    @unique @map("referral_code")
  referredById String?   @map("referred_by_id")
  // Блокировка за нарушение правил — банит логин и любые новые деньги-
  // действия (заказы/пополнения), см. getCurrentUser() и loginAction.
  isBanned     Boolean   @default(false) @map("is_banned")
  createdAt    DateTime  @default(now()) @map("created_at")
  lastLoginAt  DateTime? @map("last_login_at")

  referredBy    User?  @relation("Referrals", fields: [referredById], references: [id], onDelete: SetNull)
  referrals     User[] @relation("Referrals")

  topups        TopUp[]
  orders        Order[]
  balanceTx     BalanceTx[]
  messages      ChatMessage[]
  notifications Notification[]
  promoRedemptions PromoCodeRedemption[]
  reviews       Review[]

  @@map("users")
}

// Раздел каталога — определяет, под какой вкладкой (Игры/Сервисы/Софт)
// показывается запись.
enum GameCategory {
  game
  service
  software
}

// Позиция каталога — игра, сервис (Telegram Premium и т.п.) или софт.
// Название модели/таблицы оставлено как есть (Game/games), чтобы не менять
// весь остальной код (Package/Order уже ссылаются на неё) — category лишь
// уточняет, чем именно является запись.
model Game {
  id         String       @id @default(uuid())
  title      String
  slug       String       @unique
  imageUrl   String?      @map("image_url")
  badgeLabel String?      @map("badge_label") // короткая метка-ленточка на карточке ("TOP", "GLOBAL"…), пусто — не показывать
  category   GameCategory @default(game)
  isActive   Boolean      @default(true) @map("is_active")
  orderIndex Int          @default(0) @map("order_index")
  createdAt  DateTime     @default(now()) @map("created_at")

  packages Package[]
  orders   Order[]

  @@map("games")
}

// Конкретный товар внутри игры (пакет алмазов, пропуск и т.п.).
model Package {
  id         String      @id @default(uuid())
  gameId     String      @map("game_id")
  region     String? // "GLOBAL" | "IN" | "BR" ... — не у всех игр есть регионы
  kind       PackageKind @default(currency)
  title      String // напр. "110 алмазов", "Weekly Pass"
  imageUrl   String?     @map("image_url") // пока нет — на витрине используется generic-иконка по kind
  amount     Int         @default(0) // кол-во игровой валюты, 0 для пропусков/ваучеров
  price      Decimal     @db.Decimal(10, 2)
  isActive   Boolean     @default(true) @map("is_active")
  orderIndex Int         @default(0) @map("order_index")
  // offer_id у внешнего поставщика (сейчас FazerCards, категория free_fire_cis)
  // для автоматического заказа — пусто, если для этого товара нет пары
  // (тогда заказ остаётся на ручной обработке, как раньше). Правится через
  // админку, не хардкод.
  externalOfferId String? @map("external_offer_id")

  game   Game    @relation(fields: [gameId], references: [id], onDelete: Cascade)
  orders Order[]

  @@index([gameId])
  @@map("packages")
}

// Покупка товара в игре — списывается с баланса сразу при оформлении,
// админ вручную выдаёт валюту в игре и отмечает заказ выполненным.
model Order {
  id             String      @id @default(uuid())
  userId         String      @map("user_id")
  gameId         String      @map("game_id")
  packageId      String      @map("package_id")
  gameIdentifier String      @map("game_identifier") // игровой ID или номер телефона
  price          Decimal     @db.Decimal(10, 2) // снимок цены на момент заказа
  status         OrderStatus @default(pending)
  adminComment   String?     @map("admin_comment")
  createdAt      DateTime    @default(now()) @map("created_at")
  processedAt    DateTime?   @map("processed_at")
  // Заполняется, если заказ был отправлен во внешний API (FazerCards) на
  // автовыдачу — id заказа там (ord-XXXX), для сверки в кабинете поставщика.
  externalOrderId String?    @map("external_order_id")
  // Причина, по которой авто-заказ не был отправлен или завершился ошибкой
  // (не СНГ регион, маржа ниже порога, не хватает баланса у поставщика,
  // сбой/таймаут запроса и т.п.) — для видимости админу, не показывается
  // пользователю как есть.
  autoOrderError  String?    @map("auto_order_error")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  game    Game    @relation(fields: [gameId], references: [id], onDelete: Restrict)
  package Package @relation(fields: [packageId], references: [id], onDelete: Restrict)

  @@index([status])
  @@index([userId])
  @@map("orders")
}

// Пополнение баланса — чек на модерации у админа (тот же паттерн, что
// раньше был у Payment для покупки тарифа курса, просто без tier).
model TopUp {
  id                String        @id @default(uuid())
  userId            String        @map("user_id")
  amount            Decimal       @db.Decimal(10, 2)
  paymentMethodId   String?       @map("payment_method_id")
  receiptScreenshot String        @map("receipt_screenshot_url")
  status            PaymentStatus @default(pending)
  adminComment      String?       @map("admin_comment")
  createdAt         DateTime      @default(now()) @map("created_at")
  reviewedAt        DateTime?     @map("reviewed_at")

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  paymentMethod PaymentMethod? @relation(fields: [paymentMethodId], references: [id], onDelete: SetNull)

  @@index([status])
  @@map("topups")
}

// Журнал движений баланса — источник правды вместо доверия одному числу
// на User. amount положительный = начисление, отрицательный = списание.
model BalanceTx {
  id        String          @id @default(uuid())
  userId    String          @map("user_id")
  amount    Decimal         @db.Decimal(10, 2)
  reason    BalanceTxReason
  refId     String?         @map("ref_id") // id соответствующего TopUp/Order
  note      String? // причина ручной корректировки админом и т.п. — для истории
  // Ключ идемпотентности для операций без своего pending-статуса для
  // защиты (в отличие от Order/TopUp) — сейчас только adjustUserBalance.
  // Уникальный индекс не даёт повторный сабмит той же формы применить
  // корректировку дважды при дабл-клике/лаге.
  idempotencyKey String?    @unique @map("idempotency_key")
  createdAt DateTime        @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("balance_transactions")
}

model PaymentMethod {
  id            String  @id @default(uuid())
  bankName      String  @map("bank_name")
  phoneNumber   String  @map("phone_number")
  recipientName String  @map("recipient_name")
  logoUrl       String? @map("logo_url") // иконка банка — карточка со скриншота incurs.tj
  isActive      Boolean @default(true) @map("is_active")

  topups TopUp[]

  @@map("payment_methods")
}

// Промокод — процентная скидка на покупку товара в игре. Каждый пользователь
// может применить конкретный код только один раз (см. PromoCodeRedemption),
// maxUses/usedCount — отдельный общий лимит на все использования.
model PromoCode {
  id              String    @id @default(uuid())
  code            String    @unique
  title           String? // короткое описание для пользователя, напр. "Первая покупка"
  discountPercent Int       @map("discount_percent")
  maxUses         Int?      @map("max_uses")
  usedCount       Int       @default(0) @map("used_count")
  validFrom       DateTime? @map("valid_from")
  validUntil      DateTime? @map("valid_until")
  isActive        Boolean   @default(true) @map("is_active")
  createdAt       DateTime  @default(now()) @map("created_at")

  redemptions PromoCodeRedemption[]

  @@map("promo_codes")
}

// Факт использования промокода конкретным пользователем — не даёт применить
// один и тот же код повторно.
model PromoCodeRedemption {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  promoCodeId String   @map("promo_code_id")
  orderId     String?  @map("order_id")
  createdAt   DateTime @default(now()) @map("created_at")

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  promoCode PromoCode @relation(fields: [promoCodeId], references: [id], onDelete: Cascade)

  @@unique([userId, promoCodeId])
  @@map("promo_code_redemptions")
}

// Отзыв на странице "О нас". userId — обычные отзывы через форму (только
// зарегистрированные пользователи); null — отзывы, добавленные админом
// вручную (перенос со старого бота), name тогда вводится вручную.
model Review {
  id        String   @id @default(uuid())
  userId    String?  @map("user_id")
  name      String
  text      String
  rating    Int?
  createdAt DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("reviews")
}

// Статус задачи в разделе "Задачи" админки.
enum TaskStatus {
  open // открыта
  in_progress // в работе
  done // готова
}

// Простой тудушный список для админа/куратора (без назначения на сотрудников —
// в проекте пока только роли student/admin, отдельной системы персонала нет).
model Task {
  id          String     @id @default(uuid())
  title       String
  description String?
  status      TaskStatus @default(open)
  createdAt   DateTime   @default(now()) @map("created_at")
  completedAt DateTime?  @map("completed_at")

  @@index([status])
  @@map("tasks")
}

// Разовые расходы для раздела "Финансы". Выручка считается напрямую из
// одобренных TopUp — отдельная модель для неё не нужна.
model Expense {
  id        String   @id @default(uuid())
  title     String
  amount    Decimal  @db.Decimal(10, 2)
  category  String?
  spentAt   DateTime @default(now()) @map("spent_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("expenses")
}

// Простой чат "пользователь ↔ поддержка": один линейный тред сообщений на
// пользователя, админ видит все треды сразу. read = прочитано получателем.
model ChatMessage {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  fromAdmin Boolean  @default(false) @map("from_admin")
  text      String
  read      Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("chat_messages")
}

// Уведомления пользователя (колокольчик в личном кабинете) — например,
// "Пополнение одобрено" или "Заказ выполнен".
model Notification {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("notifications")
}

// Единственная строка (id фиксирован = 1) с общесайтовыми настройками,
// правится через админку. Пока только то, что нужно для авто-заказа через
// FazerCards — курс для пересчёта себестоимости в USD и порог маржи.
model AppSetting {
  id                  Int      @id @default(1)
  usdToTjsRate        Decimal  @default(9.22) @db.Decimal(6, 4) @map("usd_to_tjs_rate")
  // Максимальная доля себестоимости (в валюте сайта) от цены продажи, при
  // которой ещё можно авто-заказывать — выше порога цены разъехались,
  // заказ уходит в ручную очередь.
  fazercardsMarginMax Decimal  @default(0.85) @db.Decimal(4, 2) @map("fazercards_margin_max")
  updatedAt           DateTime @updatedAt @map("updated_at")

  @@map("app_settings")
}
